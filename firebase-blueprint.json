{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Apparel product item in the store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "isBestseller": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isSpecialOffer": { "type": "boolean" },
        "description": { "type": "string" },
        "fabric": { "type": "string" },
        "stock": { "type": "number" }
      },
      "required": ["id", "name", "price", "category"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "itemCount": { "type": "number" }
      },
      "required": ["id", "name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "total": { "type": "number" },
        "orderStatus": { "type": "string" }
      },
      "required": ["id", "orderNumber", "total"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review left by a customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" }
      },
      "required": ["id", "productId", "rating"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Collection of all store products"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Collection of store product categories"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Collection of customer orders"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Collection of product reviews"
    }
  }
}
